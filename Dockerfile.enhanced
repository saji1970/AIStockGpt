FROM python:3.11-slim

# Install system dependencies (including libpq for psycopg2)
RUN apt-get update && apt-get install -y gcc curl libpq-dev && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY data_collector.py lstm_model.py sensitivity_analysis.py \
     nlp_processor.py data_pipeline.py main.py config.py ./

# Create necessary directories
RUN mkdir -p data models logs

# Set environment variables
ENV PYTHONPATH=/app

# Railway sets PORT dynamically
CMD ["sh", "-c", "uvicorn backend.main_enhanced:app --host 0.0.0.0 --port ${PORT:-8080}"]
