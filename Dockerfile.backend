# ── React admin + chat UI (production / Railway) ─────────────────
FROM node:18-slim AS frontend-build
WORKDIR /fe
COPY package*.json ./
RUN npm ci --legacy-peer-deps 2>/dev/null || npm install
COPY public ./public
COPY src ./src
COPY tailwind.config.js postcss.config.js ./
ENV REACT_APP_ADMIN_MODE=full
ENV REACT_APP_API_URL=
ENV GENERATE_SOURCEMAP=false
RUN npm run build

# ── Python API ────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY data_collector.py .
COPY lstm_model.py .
COPY sensitivity_analysis.py .
COPY nlp_processor.py .
COPY data_pipeline.py .
COPY main.py .
COPY config.py .
COPY train_pipe.py .
COPY train_models.py .
COPY models/ ./models/

COPY --from=frontend-build /fe/build ./static/ui

RUN mkdir -p data logs

ENV PYTHONPATH=/app
ENV OLLAMA_BASE_URL=http://localhost:11434
ENV OLLAMA_MODEL=llama3.2
ENV HF_API_TOKEN=
ENV alphavantage_apikey=
ENV STATIC_UI_DIR=/app/static/ui
ENV GITHUB_TOKEN=
ENV GITHUB_REPO=
ENV GIT_USER_NAME="Railway Bot"
ENV GIT_USER_EMAIL="railway-bot@users.noreply.github.com"

CMD ["sh", "-c", "uvicorn backend.main_enhanced:app --host 0.0.0.0 --port ${PORT:-8080}"]
